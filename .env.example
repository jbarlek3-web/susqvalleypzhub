# Public application origin. Production must use HTTPS.
APP_URL=

# Clerk: use test keys locally and live keys only in production.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook endpoint signing secret for /api/webhooks/clerk.
CLERK_WEBHOOK_SIGNING_SECRET=

# Optional owner access. Must be one exact email verified on the signed-in Clerk account.
ADMIN_CLERK_EMAIL=

# Generate an independent random value. Never reuse it for another service.
RATE_LIMIT_SALT=

# Use the database provider's pooled Postgres connection string.
DATABASE_URL=

# Optional Google Drive project storage. If enabled, set all three values together.
# Create a Web application OAuth client and enable Drive API.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Independent 32-byte key encoded as base64 or 64 hexadecimal characters.
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=

# Optional: required only when the Pro AI analysis feature is enabled.
XAI_API_KEY=
