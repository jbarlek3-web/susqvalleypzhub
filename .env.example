# Public application origin. Production must use HTTPS.
APP_URL=

# Clerk: use test keys locally and live keys only in production.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional owner exemption. Use your exact Clerk user ID (user_...), never an email address.
OWNER_CLERK_USER_ID=

# Generate an independent random value. Never reuse it for another service.
RATE_LIMIT_SALT=

# Use the database provider's pooled Postgres connection string.
DATABASE_URL=


# Optional: required only when the Pro AI analysis feature is enabled.
XAI_API_KEY=
