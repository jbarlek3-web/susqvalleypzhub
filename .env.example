# Public application origin. Production must use HTTPS and match BETTER_AUTH_URL.
APP_URL=
BETTER_AUTH_URL=

# Generate independent random values. Never reuse either value for another service.
BETTER_AUTH_SECRET=
RATE_LIMIT_SALT=

# Use the database provider's pooled Postgres connection string.
DATABASE_URL=

# Grok authentication provider configuration.
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_AUTH_ISSUER=

# Stripe server-only configuration. Use a least-privilege rk_ key, not an sk_ key.
STRIPE_PRICE_ID=
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: required only when the Pro AI analysis feature is enabled.
XAI_API_KEY=
